# =============================================================================
# HomeServe Technologies – Production Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to '.env' in your backend and frontend deployment environments.
# 2. Replace all placeholder values (<...>) with actual secure credentials.
# 3. DO NOT commit actual '.env' files containing secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Backend Application Settings
# -----------------------------------------------------------------------------
APP_NAME="HomeServe Technologies"
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
PORT=8000
SEED_DEMO_DATA=false

# -----------------------------------------------------------------------------
# 2. Cloud MySQL Database Configuration
# Format: mysql+pymysql://<USERNAME>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
# Example: mysql+pymysql://avnadmin:SecretPass@mysql-cloud.aivencloud.com:12345/homeserve
# -----------------------------------------------------------------------------
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# -----------------------------------------------------------------------------
# 3. JWT Security & Session Credentials
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=<YOUR_GENERATED_SECURE_64_CHARACTER_SECRET_KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# 4. Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (NO wildcard '*' in production)
# -----------------------------------------------------------------------------
CORS_ORIGINS=https://your-homeserve-app.vercel.app,http://localhost:5173

# -----------------------------------------------------------------------------
# 5. Production Platform Bootstrapping
# Initial Super Administrator created if no admin exists in the database
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@homeserve.com
ADMIN_PASSWORD=<CHANGE_THIS_TO_A_COMPLEX_PASSWORD>
ADMIN_FULL_NAME="System Administrator"

# -----------------------------------------------------------------------------
# 6. Frontend Configuration (Used by Vite during build)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=https://your-backend-api.onrender.com/api
