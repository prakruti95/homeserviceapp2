# FastAPI Backend Production Environment Variables
APP_NAME="HomeServe Technologies"
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
PORT=8000
SEED_DEMO_DATA=false

# Cloud MySQL Database URL
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# JWT Secret (Generate with: openssl rand -hex 32)
SECRET_KEY=<YOUR_GENERATED_SECURE_64_CHARACTER_SECRET_KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed Frontend Origins (Comma-separated)
CORS_ORIGINS=https://your-homeserve-app.vercel.app,http://localhost:5173

# Admin Bootstrapping
ADMIN_EMAIL=admin@homeserve.com
ADMIN_PASSWORD=<STRONG_PRODUCTION_PASSWORD>
ADMIN_FULL_NAME="System Administrator"
