# -----------------------------------------------------------------------------
# HomeServe Technologies - Production .gitignore
# -----------------------------------------------------------------------------

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend Build Outputs
node_modules/
dist/
build/
deployment_build/
*.zip
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
DEMO_CREDENTIALS.md
*.pem
*.key
*.cert
*.pfx

# Local Database Files
mysql_data/
*.sqlite3
*.db
*.sql.gz
*.sql.bak

# IDE & Operating System Artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
